FROM docker.io/node:24.22.1-alpine AS npm

COPY ./package.json /build/package.json

RUN set -exu \
  && cd /build \
  && npm install --omit=dev --no-audit --no-fund

#
# runtime container
FROM docker.io/nginx:1.30.6-alpine

USER root

COPY ./public_html /var/www
# only ship the scripts the page loads, not all of node_modules
COPY --from=npm /build/node_modules/wetfish-basic/dist/basic.js /var/www/node_modules/wetfish-basic/dist/basic.js
COPY --from=npm /build/node_modules/dragondrop/dragondrop.js /var/www/node_modules/dragondrop/dragondrop.js
COPY ./nginx.conf /etc/nginx/conf.d/default.conf

RUN set -exu \
  && chown -R nginx:nginx /var/www

# taken from nginx dockerfile here
# https://github.com/nginxinc/docker-nginx/blob/fef51235521d1cdf8b05d8cb1378a526d2abf421/stable/alpine/Dockerfile
ENTRYPOINT ["/docker-entrypoint.sh"]
EXPOSE 80
STOPSIGNAL SIGQUIT
CMD ["nginx", "-g", "daemon off;"]
